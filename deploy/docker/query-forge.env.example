# QueryForge container runtime environment
CURRENT_ENVIRONMENT=production

# Caddy public entrypoint. Use ":80" for local HTTP-only testing.
# For production HTTPS, set this to the public domain, for example:
# QF_SITE_ADDRESS=queryforge.example.com
QF_SITE_ADDRESS=:80
QF_HTTP_PORT=80
QF_HTTPS_PORT=443

# RDS MySQL
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=query_forge
DB_SSL_CA=
POOL_SIZE=10
MAX_OVERFLOW=20
POOL_TIMEOUT=30
POOL_RECYCLE=1800

# One-shot Docker migration runner. Use QF_MIGRATIONS_MODE=plan to list
# unapplied migrations, or baseline to record already-applied SQL files.
QF_MIGRATIONS_MODE=apply
QF_MIGRATIONS_TABLE=query_forge_schema_migrations

# Auth and cookies
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_LEEWAY_SECONDS=120
JWT_VERIFY_IAT=false
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
REFRESH_COOKIE_PATH=/api/v1/auth
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax

# Public URLs
FRONTEND_BASE_URL=https://example.com
INVITE_URL=https://example.com/auth/register
PASSWORD_RESET_URL=https://example.com/auth/reset
FLOWFORGE_WEBHOOK_BASE_URL=https://example.com

# Valkey. For bundled Compose Valkey, leave host as valkey.
VALKEY_ADDRESS=valkey
VALKEY_PORT=6379
LOG_QUEUE=API_LOG
QF_CELERY_WORKER_POOL=prefork
QF_CELERY_WORKER_CONCURRENCY=1

# Qdrant. For bundled Compose Qdrant, leave URL as qdrant.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_DOMAIN_COLLECTION=domain_catalog_v1
QDRANT_TABLE_COLLECTION=table_catalog
QDRANT_COLUMN_COLLECTION=column_catalog
QDRANT_COLUMN_COLLECTION_V2=column_catalog_v2
QDRANT_SEMANTIC_CONCEPT_COLLECTION=semantic_concepts_v1

# Workspace LLM encryption and default LLM fallbacks
QF_LLM_ENCRYPTION_KEY=
VLLM_BASE_URL=
VLLM_MODEL=
VLLM_TIMEOUT=60
SEMANTIC_LLM_ENDPOINT=
SEMANTIC_LLM_API_KEY=
SEMANTIC_LLM_MODEL=
SEMANTIC_LLM_TIMEOUT_SECONDS=60
SEMANTIC_PLAN_LLM_MODEL=
SEMANTIC_PLAN_LLM_TIMEOUT_SECONDS=60
SEMANTIC_PLAN_LLM_MAX_TOKENS=1200

# Planner and semantic feature flags
QF_WORKSPACE_LLM_RUNTIME_ENABLED=1
QF_PLANNER_LLM_ENABLED=0
QF_PLAN_DOMAIN_SEMANTIC_ASSIST_ENABLED=0
QF_PLAN_DOMAIN_LLM_EXPLANATION_ENABLED=0
QF_PLAN_DOMAIN_LLM_NEXT_ACTIONS_ENABLED=1
QF_PLAN_DOMAIN_FAST_MODE_DEFAULT=0
PLANNER_UNIFIED_LLM=0
NLP_TIER2_ENABLED=0
SEMANTIC_STATS_ENABLED=1
SEMANTIC_CONCEPT_SEED_ON_STARTUP=0
FORGE_MATCH_VECTOR_ENABLED=true
DESTINATION_ENCRYPTION_KEY=

# FlowForge integrations
FLOWFORGE_JOTFORM_WEBHOOK_TOKEN=
FLOWFORGE_QUERY_EXTRACT_DEFAULT_LIMIT=100
FLOWFORGE_QUERY_EXTRACT_MAX_LIMIT=0

# MCP and OAuth
MCP_ENABLED=false
MCP_REQUIRE_WORKSPACE_ENABLEMENT=true
MCP_REQUIRE_CHANNEL_GRANT=true
MCP_REQUIRE_QUERY_STUDIO_FOR_PREVIEW=true
MCP_RESOURCE_URL=https://example.com
MCP_AUTHORIZATION_SERVER_URL=https://example.com
MCP_OAUTH_SCOPES_SUPPORTED=qf:mcp:read,qf:mcp:plan,qf:mcp:preview
MCP_INCLUDE_RAW_SQL=false
MCP_DEFAULT_PREVIEW_ROW_LIMIT=100
MCP_MAX_PREVIEW_ROW_LIMIT=500
MCP_RATE_LIMIT_PER_USER_PER_MINUTE=60
MCP_RATE_LIMIT_PER_CLIENT_PER_MINUTE=120
MCP_RATE_LIMIT_PREVIEW_PER_USER_PER_MINUTE=10
MCP_BLOCK_SENSITIVE_DOMAINS=false
OAUTH_ISSUER_URL=https://example.com
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_AUTH_CODE_TTL_SECONDS=300
OAUTH_REFRESH_TOKEN_TTL_SECONDS=1209600
OAUTH_CLIENT_TTL_SECONDS=2592000
OAUTH_ALLOWED_REDIRECT_HOSTS=chatgpt.com
OAUTH_ALLOW_LOOPBACK_REDIRECTS=false
OAUTH_REQUIRE_PKCE=true
OAUTH_ALLOWED_CODE_CHALLENGE_METHODS=S256
OAUTH_ENABLE_DYNAMIC_CLIENT_REGISTRATION=true
OAUTH_ENABLE_REFRESH_TOKENS=true
OAUTH_CONSENT_EXPIRES_WITH_REFRESH_TOKEN=true
OAUTH_ENABLE_APP_CLIENT_AUTH=true

# Mail and password policy
PASSWORD_CHECK_URL=https://api.pwnedpasswords.com/range/
MIN_PASSWORD_LENGTH=15
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SERVER=
SMTP_PORT=587
DEFAULT_MAIL_SENDER=
SALES_INQUIRY_EMAIL=

# Optional AWS-backed local LLM controls
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
LLM_INSTANCE_ID=
LLM_STATUS_CACHE_SECONDS=5
